<div class="banner banner--{{ section.settings.layout_width }}">
  {%- if section.settings.show_heading -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>{{ block.settings.label }}{{ block.settings.text }}</div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Willkommen"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Überschrift zeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_divider",
      "label": "Trennlinie ausblenden"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Breite",
      "default": "wrapper--narrow",
      "options": [
        {
          "value": "wrapper--narrow",
          "label": "Schmal"
        },
        {
          "value": "wrapper--full",
          "label": "Volle Breite"
        },
        {
          "value": "wrapper--split",
          "label": "Geteilt"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung",
          "default": "Mehr erfahren"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
